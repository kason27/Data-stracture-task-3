#include <stdio.h>

int main() {
    int a[20][20], sp[100][3];
    int rows, cols, i, j, k = 1;

    printf("Enter rows and columns: ");
    scanf("%d %d", &rows, &cols);

    printf("Enter the matrix:\n");
    for (i = 0; i < rows; i++) {
        for (j = 0; j < cols; j++) {
            scanf("%d", &a[i][j]);
            if (a[i][j] != 0) {
                sp[k][0] = i;
                sp[k][1] = j;
                sp[k][2] = a[i][j];
                k++;
            }
        }
    }

    sp[0][0] = rows;
    sp[0][1] = cols;
    sp[0][2] = k - 1;

    printf("\nRow\tCol\tValue\n");
    for (i = 0; i < k; i++)
        printf("%d\t%d\t%d\n", sp[i][0], sp[i][1], sp[i][2]);

    return 0;
}
